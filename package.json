{
  "name": "ainovel-studio",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "description": "Local-first AI novel writing studio with a complete writing backend",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "next dev --webpack",
    "dev:turbopack": "next dev",
    "build": "next build --webpack && npm run build:runner",
    "build:runner": "tsup src/server/run/runner-main.ts src/server/commit/commit-reconciler-main.ts --format cjs --platform node --target node20 --out-dir dist-worker --external better-sqlite3",
    "build:turbopack": "next build",
    "postbuild": "node scripts/copy-standalone-assets.mjs",
    "clone:rerun": "node --import tsx scripts/clone-project-for-rerun.mjs",
    "foundation:handoff": "node --import tsx scripts/export-foundation-handoff.mjs",
    "entity:audit": "node --import tsx scripts/entity-audit.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "runner:dev": "node --import tsx src/server/run/runner-main.ts",
    "runner:prod": "node dist-worker/runner-main.js",
    "reconciler:dev": "node --import tsx scripts/run-commit-reconciler.mjs",
    "reconciler:prod": "node scripts/run-commit-reconciler.mjs --prod",
    "foundation:diagnose": "node --import tsx scripts/foundation-truth-source.ts diagnose",
    "foundation:repair": "node --import tsx scripts/foundation-truth-source.ts repair",
    "eval:baseline": "node --import tsx src/server/content/eval-baseline.ts",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-default-type=module --test \"src/server/**/*.test.ts\"",
    "test:ui": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-virtual": "^3.13.23",
    "better-sqlite3": "^12.8.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.1",
    "gsap": "^3.15.0",
    "lucide-react": "^0.577.0",
    "nanoid": "^5.1.7",
    "next": "16.1.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "server-only": "^0.0.1",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@storybook/addon-essentials": "^8.5.0",
    "@storybook/addon-interactions": "^8.5.0",
    "@storybook/addon-links": "^8.5.0",
    "@storybook/blocks": "^8.5.0",
    "@storybook/nextjs": "^8.5.0",
    "@storybook/react": "^8.5.0",
    "@storybook/test": "^8.5.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.1.7",
    "jsdom": "^29.0.1",
    "tailwindcss": "^4",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.2"
  }
}
